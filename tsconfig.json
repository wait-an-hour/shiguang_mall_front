{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["web/src/*"]
    },
    "types": ["vite/client"]
  },
  "include": ["web/src/**/*.ts", "web/src/**/*.d.ts", "web/src/**/*.tsx", "web/src/**/*.vue", "web/vite.config.ts"],
  "exclude": ["src"]
}
